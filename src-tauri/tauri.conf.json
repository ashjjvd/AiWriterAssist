{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Writer Assistant",
    "version":  "0.2.0",
    "identifier":  "app.writer.assistant",
    "build":  {
                  "beforeDevCommand":  "pnpm dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "withGlobalTauri":  false,
                "windows":  [
                                {
                                    "label":  "settings",
                                    "title":  "Writer Assistant — Settings",
                                    "width":  1050,
                                    "height":  720,
                                    "minWidth":  760,
                                    "minHeight":  560,
                                    "url":  "/index.html?window=settings",
                                    "visible":  true
                                },
                                {
                                    "label":  "assistant",
                                    "title":  "Writer Assistant",
                                    "width":  560,
                                    "height":  690,
                                    "minWidth":  440,
                                    "minHeight":  400,
                                    "visible":  false,
                                    "alwaysOnTop":  true,
                                    "decorations":  false,
                                    "skipTaskbar":  true,
                                    "url":  "/index.html?window=assistant"
                                },
                                {
                                    "label":  "synonyms",
                                    "title":  "Synonyms",
                                    "width":  360,
                                    "height":  450,
                                    "minWidth":  300,
                                    "minHeight":  250,
                                    "visible":  false,
                                    "alwaysOnTop":  true,
                                    "decorations":  false,
                                    "skipTaskbar":  true,
                                    "url":  "/index.html?window=synonyms"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src ipc: http://ipc.localhost; img-src \u0027self\u0027 data:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "resources":  [
                                     "resources/dictionaries/*",
                                     "resources/licenses/*"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/icon.ico",
                                "icons/icon.icns"
                            ]
               }
}